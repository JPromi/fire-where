{
  "expo": {
    "name": "Fire Where",
    "slug": "fire-where",
    "version": "1.1.0",
    "scheme": "firewhere",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jpromi.firePoint",
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "associatedDomains": [
        "applinks:app.fire-where.at"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "https",
          "http"
        ]
      }
    },
    "android": {
      "package": "com.jpromi.firePoint",
      "versionCode": 7,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.fire-where.at"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
